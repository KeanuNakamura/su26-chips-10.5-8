.row
  .col-12.col-md-10.offset-md-1
    %h1.text-center.mb-4 Edit News Item

    %p#ci-search-representative
      %strong Representative:
      = link_to @representative.name, representative_path(@representative)

    %p#ci-search-issue
      %strong Issue:
      = @issue

    %h2.h5.mt-4 Select an article:

    - if @articles.blank?
      .alert.alert-info#ci-no-articles
        No articles were found for this issue.
    - else
      = form_tag representative_new_my_news_item_path(@representative), method: :post do
        %fieldset
          %legend.visually-hidden Select an article
          - @articles.each_with_index do |article, index|
            .form-check.mb-4
              = radio_button_tag 'article_url', article[:url], index.zero?,
                                 id: "article_#{index}", class: 'form-check-input'
              %label.form-check-label{ for: "article_#{index}" }
                %p
                  %strong Title:
                  = article[:title]
                %p
                  %strong Link:
                  = link_to article[:url], article[:url], class: 'link-dark',
                            target: '_blank', rel: 'noopener noreferrer'
                %p
                  %strong Description:
                  = article[:description]
              = hidden_field_tag "articles[#{index}][title]", article[:title]
              = hidden_field_tag "articles[#{index}][description]",
                                 article[:description]
              = hidden_field_tag "articles[#{index}][url]", article[:url]
        = hidden_field_tag :issue, @issue
        .text-center
          = submit_tag 'Save', class: 'btn btn-primary'

    .mt-4
      .float-end
        = link_to representative_news_items_path(@representative), class: 'btn btn-info' do
          View News Articles
          %i.fas.fa-arrow-right